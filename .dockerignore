# Keep the build context small and the image free of developer-only files.

# VCS and tooling
.git
.github
.gitnexus
.claude
.idea
.vscode

# Python caches and environments
__pycache__
*.pyc
*.pyo
*.egg-info
.venv
venv
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
coverage.xml
htmlcov

# Secrets and local config
.env
.env.*
!.env.example

# Runtime data — mounted at runtime, never baked into the image
data
results
models
output
*.db
*.sqlite
*.log

# Not needed by the runtime image
tests
docs
scripts
# ...except the smoke benchmark, which the `bench` build target copies in.
# A negation must follow the rule it overrides.
!scripts/benchmark_smoke.py
requirements
Makefile
*.md
Dockerfile
docker-compose.yml
dist
build
