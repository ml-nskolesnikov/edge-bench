# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/

# Database
*.db
*.sqlite
*.sqlite3

# Environment variables — the template is tracked, real values never are
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Models (binary weights should not be in git)
data/models/*.tflite
data/models/*.pb
data/models/*.onnx

# Upload cache
data/uploads/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Output / generated files
output/

# Benchmark results
# results/ is a research artifact and IS tracked — measured runs must stay
# reproducible and reviewable. Only throwaway validation output is ignored.
results/smoke/

# Local tooling artifacts (not project source)
.claude
CLAUDE.md
AGENTS.md
.gitnexus
