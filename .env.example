# Edge-Bench configuration template.
# Copy to .env and adjust. Every value below is a default — the application
# starts with no .env at all. Never commit a filled-in .env.
#
#   cp .env.example .env
#
# All server settings use the EDGEBENCH_ prefix (see server/core/config.py).

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
EDGEBENCH_HOST=0.0.0.0
EDGEBENCH_PORT=8000
# Enables uvicorn autoreload. Never enable in production.
EDGEBENCH_DEBUG=false

# ---------------------------------------------------------------------------
# Storage paths
# Relative paths resolve against the process working directory (the repo root
# locally, /app inside the container).
# ---------------------------------------------------------------------------
EDGEBENCH_DATABASE_PATH=data/edgebench.db
EDGEBENCH_MODELS_DIR=data/models
EDGEBENCH_UPLOAD_DIR=data/uploads
EDGEBENCH_SCRIPTS_DIR=data/scripts

# ---------------------------------------------------------------------------
# Task queue
# ---------------------------------------------------------------------------
EDGEBENCH_MAX_CONCURRENT_TASKS=1
EDGEBENCH_TASK_TIMEOUT_SECONDS=3600

# ---------------------------------------------------------------------------
# Agent communication
# ---------------------------------------------------------------------------
EDGEBENCH_AGENT_TIMEOUT_SECONDS=30
EDGEBENCH_AGENT_DEFAULT_PORT=8001

# Shared secret required in the X-Agent-Secret header on /api/* requests.
# Empty disables auth — acceptable only on a trusted LAN.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
EDGEBENCH_AGENT_SECRET=

# Trusted source for X-Forwarded-* headers. Set to your reverse proxy's IP
# when one is deployed; leave as loopback otherwise.
EDGEBENCH_PROXY_TRUST=127.0.0.1

# ---------------------------------------------------------------------------
# Optional integrations (empty = disabled)
# ---------------------------------------------------------------------------
EDGEBENCH_MLFLOW_TRACKING_URI=
EDGEBENCH_MLFLOW_EXPERIMENT_NAME=edge-bench
EDGEBENCH_WANDB_API_KEY=

# ---------------------------------------------------------------------------
# Benchmark reproducibility
# Consumed by the agent and the benchmark scripts, not by the server.
# ---------------------------------------------------------------------------
EDGEBENCH_INPUT_SEED=42
EDGEBENCH_COOLDOWN_SECONDS=5

# ---------------------------------------------------------------------------
# Agent-side settings (set these on the Raspberry Pi, not on the server)
# ---------------------------------------------------------------------------
# EDGEBENCH_SERVER=http://192.168.1.10:8000
# EDGEBENCH_AGENT_PORT=8001
# EDGEBENCH_AGENT_SECRET=<same value as the server>
